# Ether Hunt — local env example

PORT=8787
AUDIT_API_URL=http://127.0.0.1:8787

# Local UI/agent only — set false for Hedera prize demos
DEV_BYPASS_PAYMENT=true
ALLOW_AGENT_DEV_BYPASS=true

# Hedera x402 (required for live paywall) — use ECDSA accounts, not ED25519
# HEDERA_SERVICE_ACCOUNT_ID=0.0.xxxxx
# HEDERA_SERVICE_PRIVATE_KEY=0x...   # for USDC associate script only
# HEDERA_AGENT_ACCOUNT_ID=0.0.yyyyy
# HEDERA_AGENT_PRIVATE_KEY=0x...   # HEX Encoded Private Key of agent payer
# X402_NETWORK=hedera:testnet
# X402_ASSET=hbar          # or usdc (needs Circle faucet)
# X402_PRICE='$0.01'         # used when X402_ASSET=usdc
# X402_HBAR_AMOUNT=100000  # 0.001 HBAR in tinybars when X402_ASSET=hbar
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# mainnet facilitator: https://api.blocky402.com

# The Graph (required for Graph prize — Studio query URL after deploy)
# GRAPH_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<ID>/ether-hunt-approvals/<VERSION>
# GRAPH_API_KEY=

# Optional Ethereum RPC for non-Graph approval fallback
# ETH_RPC_URL=https://ethereum.publicnode.com

# Optional LLM (Graph-grounded AI synthesis) — DeepSeek preferred
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ARC_AGENT_ADDRESS=0x...
# ARC_SERVICE_ADDRESS=0x...          # seller payTo (can differ from agent)
# ARC_CHAIN=ARC-TESTNET
# X402_ARC_PRICE='$0.01'
# CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Agent payment proof from official x402 signer (when not using bypass)
# PAYMENT_HEADER=
